---
import "./thiqa.css";
import { cssVariableName, darkTokens, lightTokens, type ColorTokens } from "@rakazo/ui-tokens";
import { THIQA_COPY } from "./copy";
import {
  FORK_REPO_URL,
  THIQA_APP_URL,
  THIQA_LOCALE_PATH,
  THIQA_PLANS,
  UPSTREAM_REPO_URL,
  thiqaPlansUrl,
  thiqaSignUpUrl,
  type ThiqaLocale,
} from "./site";

type Props = { locale: ThiqaLocale };

const { locale } = Astro.props;
const t = THIQA_COPY[locale];
const other: ThiqaLocale = locale === "ar" ? "en" : "ar";
const signUp = thiqaSignUpUrl(locale);
const signIn = `${THIQA_APP_URL}/${locale}/sign-in`;
const year = new Date().getFullYear();

const palette = (tokens: ColorTokens) =>
  (Object.keys(tokens) as (keyof ColorTokens)[]).map((k) => `${cssVariableName(k)}:${tokens[k]};`).join("");
const tokenCss = `:root{color-scheme:light;${palette(lightTokens)}}@media (prefers-color-scheme:dark){:root{color-scheme:dark;${palette(darkTokens)}}}`;

const nav = [
  { href: "#abilities", label: t.nav.abilities },
  { href: "#agencies", label: t.nav.agencies },
  { href: "#how", label: t.nav.how },
  { href: "#pricing", label: t.nav.pricing },
  { href: "#faq", label: t.nav.faq },
];
const number = new Intl.NumberFormat(locale === "ar" ? "ar-SA" : "en-US");
---

<!doctype html>
<html lang={t.lang} dir={t.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "ar" ? "ar_SA" : "en_US"} />
    <link rel="alternate" hreflang={other} href={THIQA_LOCALE_PATH[other]} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
    />
    <style is:inline set:html={tokenCss} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>

    <header class="sticky top-0 z-40 border-b border-line bg-ground/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
        <a href={THIQA_LOCALE_PATH[locale]} class="flex items-center gap-2 font-bold text-ink">
          <span aria-hidden="true" class="grid size-8 place-items-center rounded-lg bg-primary text-on-primary">ث</span>
          <span>{t.brand}</span>
        </a>
        <nav aria-label={t.nav.label} class="hidden flex-1 items-center gap-5 text-sm text-muted md:flex">
          {nav.map((item) => <a class="hover:text-ink" href={item.href}>{item.label}</a>)}
        </nav>
        <div class="ms-auto flex items-center gap-3 text-sm">
          <a
            href={THIQA_LOCALE_PATH[other]}
            hreflang={other}
            lang={other}
            aria-label={t.switchTo}
            class="rounded-md px-2 py-1 text-muted hover:text-ink">{t.switchLabel}</a
          >
          <a href={signIn} class="hidden text-muted hover:text-ink sm:inline">{t.signIn}</a>
          <a href={signUp} class="rounded-lg bg-primary px-4 py-2 font-semibold text-on-primary hover:opacity-90">{t.cta}</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="mx-auto max-w-6xl px-5 pt-16 pb-12 text-center md:pt-24">
        <p class="mx-auto inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-sm text-muted">
          <span class="size-2 rounded-full bg-primary" aria-hidden="true"></span>
          {t.hero.badge}
        </p>
        <h1 class="mx-auto mt-6 max-w-3xl text-4xl leading-tight font-bold text-ink md:text-6xl">{t.hero.heading}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{t.hero.lead}</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href={signUp} class="rounded-xl bg-primary px-6 py-3 text-lg font-semibold text-on-primary hover:opacity-90">{t.cta}</a>
          <a href="#how" class="rounded-xl border border-line bg-card px-6 py-3 text-lg font-medium text-ink hover:bg-soft">{t.hero.secondary}</a>
        </div>
        <p class="mt-4 text-sm text-muted">{t.hero.note}</p>

        <figure class="mx-auto mt-14 max-w-5xl text-start">
          <div class="overflow-hidden rounded-2xl border border-line bg-card shadow-2xl shadow-black/10">
            <div class="flex items-center gap-1.5 border-b border-line px-4 py-3" aria-hidden="true">
              <span class="size-3 rounded-full bg-line"></span>
              <span class="size-3 rounded-full bg-line"></span>
              <span class="size-3 rounded-full bg-line"></span>
            </div>
            <div class="grid md:grid-cols-[200px_1fr]">
              <ul class="hidden space-y-1 border-e border-line bg-soft p-4 text-sm md:block" aria-hidden="true">
                {t.demo.sidebar.map((item, i) => (
                  <li class:list={["rounded-lg px-3 py-2", i === 0 ? "bg-card font-semibold text-ink" : "text-muted"]}>{item}</li>
                ))}
              </ul>
              <ol class="space-y-3 p-4 md:p-6">
                {t.demo.feed.map((entry) => (
                  <li class="rounded-xl border border-line bg-ground p-4">
                    <div class="flex items-center gap-2 text-sm">
                      <span class="grid size-7 place-items-center rounded-full bg-soft font-bold text-clay" aria-hidden="true">{entry.who.slice(0, 1)}</span>
                      <span class="font-semibold text-ink">{entry.who}</span>
                      <span class="ms-auto text-muted">{entry.time}</span>
                    </div>
                    <p class="mt-2 text-ink">
                      {entry.state === "working" && <span class="pulse me-2 inline-block size-2 animate-pulse rounded-full bg-clay" aria-hidden="true"></span>}
                      {entry.text}
                    </p>
                    {entry.state === "ask" && (
                      <div class="mt-3 flex gap-2" aria-hidden="true">
                        <span class="rounded-lg bg-primary px-3 py-1.5 text-sm font-semibold text-on-primary">{t.demo.approve}</span>
                        <span class="rounded-lg border border-line px-3 py-1.5 text-sm text-ink">{t.demo.decline}</span>
                      </div>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <figcaption class="mt-3 text-center text-sm text-muted">{t.demo.label}</figcaption>
        </figure>
      </section>

      <section id="abilities" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20">
        <p class="font-semibold text-clay">{t.abilities.eyebrow}</p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold text-ink md:text-4xl">{t.abilities.heading}</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {t.abilities.items.map((item) => (
            <article class="rounded-2xl border border-line bg-card p-6">
              <h3 class="text-lg font-bold text-ink">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="agencies" class="scroll-mt-20 border-y border-line bg-soft">
        <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-2">
          <div>
            <p class="font-semibold text-clay">{t.agencies.eyebrow}</p>
            <h2 class="mt-2 text-3xl font-bold text-ink md:text-4xl">{t.agencies.heading}</h2>
            <p class="mt-4 text-lg leading-relaxed text-muted">{t.agencies.copy}</p>
            <dl class="mt-8 space-y-5">
              {t.agencies.points.map((point) => (
                <div>
                  <dt class="font-bold text-ink">{point.title}</dt>
                  <dd class="mt-1 text-muted">{point.body}</dd>
                </div>
              ))}
            </dl>
          </div>
          <ul class="space-y-3" aria-hidden="true">
            {t.agencies.clients.map((client, i) => (
              <li class:list={["flex items-center gap-3 rounded-2xl border border-line bg-card p-5", i === 0 && "ring-2 ring-primary"]}>
                <span class="grid size-10 place-items-center rounded-xl bg-soft font-bold text-clay">{client.name.slice(0, 1)}</span>
                <span class="font-semibold text-ink">{client.name}</span>
                <span class="ms-auto rounded-full bg-soft px-3 py-1 text-sm text-muted">{client.agents}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section id="how" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-20">
        <p class="font-semibold text-clay">{t.how.eyebrow}</p>
        <h2 class="mt-2 max-w-2xl text-3xl font-bold text-ink md:text-4xl">{t.how.heading}</h2>
        <ol class="mt-10 grid gap-4 md:grid-cols-3">
          {t.how.steps.map((step, i) => (
            <li class="rounded-2xl border border-line bg-card p-6">
              <span class="grid size-9 place-items-center rounded-full bg-primary font-bold text-on-primary" aria-hidden="true">{number.format(i + 1)}</span>
              <h3 class="mt-4 text-lg font-bold text-ink">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="pricing" class="scroll-mt-20 border-y border-line bg-soft">
        <div class="mx-auto max-w-6xl px-5 py-20">
          <p class="font-semibold text-clay">{t.pricing.eyebrow}</p>
          <h2 class="mt-2 text-3xl font-bold text-ink md:text-4xl">{t.pricing.heading}</h2>
          <p class="mt-3 text-lg text-muted">{t.pricing.copy}</p>
          <ul class="mt-10 grid gap-4 md:grid-cols-3">
            {THIQA_PLANS.map((plan) => (
              <li class:list={["rounded-2xl border bg-card p-6", plan.id === "growth" ? "border-primary" : "border-line"]}>
                <h3 class="font-bold text-ink">{t.pricing.names[plan.id]}</h3>
                <p class="mt-3 text-ink">
                  <span class="text-3xl font-bold">{t.pricing.currency} {number.format(plan.monthly)}</span>
                  <span class="text-muted"> {t.pricing.perMonth}</span>
                </p>
                <p class="mt-2 text-muted">{t.pricing.employees(plan.employees)}</p>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={thiqaPlansUrl(locale)} class="rounded-xl border border-line bg-card px-5 py-2.5 font-semibold text-ink hover:bg-ground">{t.pricing.seePlans}</a>
            <p class="text-muted">{t.pricing.trial}</p>
          </div>
        </div>
      </section>

      <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-5 py-20">
        <h2 class="text-3xl font-bold text-ink md:text-4xl">{t.faq.heading}</h2>
        <div class="mt-8 divide-y divide-line border-y border-line">
          {t.faq.items.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center gap-4 text-lg font-semibold text-ink">
                {item.question}
                <span class="faq-mark ms-auto text-2xl text-muted transition-transform" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-5 pb-20">
        <div class="rounded-3xl bg-primary px-6 py-14 text-center text-on-primary">
          <h2 class="text-3xl font-bold md:text-4xl">{t.final.heading}</h2>
          <p class="mx-auto mt-3 max-w-xl text-lg opacity-90">{t.final.copy}</p>
          <a href={signUp} class="mt-8 inline-block rounded-xl bg-ground px-6 py-3 text-lg font-semibold text-ink hover:opacity-90">{t.cta}</a>
        </div>
      </section>
    </main>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 text-sm text-muted md:flex-row md:items-center">
        <div>
          <p class="font-bold text-ink">{t.brand} <span class="font-normal text-muted">· {t.brandBy}</span></p>
          <p class="mt-1">{t.footer.tagline}</p>
        </div>
        <div class="md:ms-auto md:text-end">
          <p>
            {t.footer.basedOn} <a class="underline hover:text-ink" href={UPSTREAM_REPO_URL} lang="en">{t.footer.basedOnLink}</a> <span lang="en" dir="ltr">{t.footer.license}</span>
          </p>
          <p class="mt-1">
            <a class="underline hover:text-ink" href={FORK_REPO_URL}>{t.footer.source}</a> · © <span dir="ltr">{year}</span> {t.footer.rights}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
